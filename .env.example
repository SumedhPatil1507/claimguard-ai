# ClaimGuard AI — Environment Variables

# LLM
GROQ_API_KEY=your_groq_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/claimguard
# Optional semicolon-separated read endpoint DSNs, tried before DATABASE_URL.
# For asyncpg multi-host failover within one cluster, use its host list syntax:
# postgresql://user:password@host1:26257,host2:26257,host3:26257/claimguard?sslmode=verify-full
DATABASE_READ_REPLICA_URLS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Encryption
ENCRYPTION_KEY=your_fernet_key_here

# API Keys (JSON mapping key->role)
API_KEYS={"admin-key-123": "admin", "analyst-key-456": "analyst", "viewer-key-789": "viewer"}

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
