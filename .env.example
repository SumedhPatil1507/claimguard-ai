# ClaimGuard AI — Environment Variables

# LLM
GROQ_API_KEY=your_groq_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/claimguard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Encryption
ENCRYPTION_KEY=your_fernet_key_here

# API Keys (JSON mapping key->role)
API_KEYS={"admin-key-123": "admin", "analyst-key-456": "analyst", "viewer-key-789": "viewer"}

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
